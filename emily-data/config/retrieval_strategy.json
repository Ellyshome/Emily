      "intent": "文档/方案/手册/纪要/图纸的内容",
      "prefer": "知识库检索",
      "fallback": ["文件台账"]
    },
    {
      "intent": "文件在哪/有哪些文件/版本/附件",
      "prefer": "文件台账",
      "fallback": ["知识库检索"]
    },
    {
      "intent": "节点进度/状态/成果/待办",
      "prefer": "节点台账",
      "fallback": ["结构化业务数据"]
    },
    {
      "intent": "事件/任务/会议记录",
      "prefer": "结构化业务数据",
      "fallback": ["知识库检索"]
    },
    {
      "intent": "投标/报价/成本/供应商等敏感数值",
