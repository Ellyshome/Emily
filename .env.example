EMILY_LLM_API_KEY=your-api-key-here
EMILY_LLM_BASE_URL=https://api.deepseek.com
EMILY_LLM_MODEL=deepseek-v4-flash
# 模型分层与采样（可选；不设则取代码默认值，改动后需 docker compose up -d emily-core 重建容器）
# EMILY_LLM_ROUTER_MODEL=deepseek-v4-flash
# EMILY_LLM_GUARDIAN_MODEL=deepseek-v4-flash
# EMILY_LLM_AGENT_LOOP_MODEL=deepseek-v4-pro
# EMILY_EXPERT_MODEL=deepseek-chat
# EMILY_LLM_TEMPERATURE=0.1
# EMILY_LLM_MAX_TOKENS=1024
# EMILY_LLM_AGENT_LOOP_MAX_TOKENS=8192
# EMILY_LLM_CONTEXT_WINDOW_OVERRIDE=0
# 运行形态与日志（可选）
# EMILY_TAKEOVER_MODE=monitor
# EMILY_BOT_NAME=Emy
# EMILY_LOG_LEVEL=INFO
# EMILY_SCHEDULER_ENABLED=true
# EMILY_SESSION_ARCHIVE_ENABLED=true
EMILY_API_TOKEN=<生成一个强随机 token，用于 API 鉴权>

# 数据库
EMILY_DATABASE_URL=postgresql://emily:PASSWORD@emily-postgres:5432/emily

# RAG 知识库（pgvector + SiliconFlow Embedding API / 本地 TEI 二选一）
EMILY_KB_ENABLED=false
# 方式一：SiliconFlow 远程 Embedding API（推荐，无需本地 GPU/大内存）
EMILY_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMILY_EMBEDDING_MODEL=BAAI/bge-m3
# 方式二：本地 TEI 容器（需 BGE-m3 模型 ~4.3GB，若用远程 API 则无需设置）
# EMILY_TEI_URL=http://tei:80
EMILY_RAG_SIMILARITY_THRESHOLD=0.3

# VLM 视觉大模型 / Embedding（共用 SiliconFlow Key）
SILICONFLOW_API_KEY=<你的 SiliconFlow API KEY>
EMILY_VLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
EMILY_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 存储与配置路径
EMILY_STORAGE_ROOT=/app/attachments
EMILY_HOOK_CONFIG_PATH=/app/config/hook_config.json

# ── 对外域名与证书（nginx 反代用）──
# EMILY_DOMAIN 需解析到本机公网 IP；小程序强制要求 HTTPS + 已 ICP 备案
EMILY_DOMAIN=ellym.asia

# 证书文件（相对仓库根路径）。task proxy:render 会规范化复制为
# /etc/nginx/ssl/emily/fullchain.pem 与 emily.key，nginx 配置无需随文件名变动
# ⚠️ 当前证书为 90 天 DV 证书（2026-09-14 → 2026-12-12），到期需重新签发替换
EMILY_SSL_CERT=ssl/ellym.asia.pem
EMILY_SSL_KEY=ssl/ellym.asia.key

# 微信小程序渠道依赖的对外域名（nginx 路径分流后的网关地址，须带 /wxmp 前缀）
# 供 emy-console「渠道连通性」探测 <该地址>/health；留空则显示未配置
EMILY_WXMP_DOMAIN=https://ellym.asia/wxmp

# 小程序文件通道：Core 回拉「用户上传的暂存附件」时所用的网关地址（网关视角可达）。
# 默认 http://wechat-gateway:18090（同 compose 网络内网名），仅在 Core 与网关不在
# 同一 docker 网络时才需覆盖，例如 Core 在容器、网关跑在宿主机时改为
# http://host.docker.internal:18090 或宿主机局域网 IP。
# 注意：这是「Core → 网关」的地址，与上面的对外域名（小程序 → 网关）无关，勿带 /wxmp。
# WXMP_SELF_URL=http://wechat-gateway:18090

# 运行模式（生产环境建议 real）
EMILY_EXECUTOR_MODE=real
EMILY_PLANNER_MODE=real
EMILY_AUTH_MODE=real
EMILY_RISK_MODE=real

# 邮箱（可选）
EMILY_EMAIL_IDKEY=
EMILY_EMAIL_PASSWORD=

# Ops Scheduler（可选）
EMILY_OPS_ENABLED=true
# EMILY_OPS_MAILBOX_ENABLED=true
# EMILY_OPS_MAIL_IMAP_HOST=imap.qq.com
# EMILY_OPS_MAIL_IMAP_PORT=993
# EMILY_OPS_MAIL_USERNAME=ops@company.com
# EMILY_OPS_MAIL_PASSWORD=your-password
# EMILY_OPS_MAIL_SENDER_WHITELIST=admin@company.com
EMILY_OPS_STARTUP_REPORT_ENABLED=true
