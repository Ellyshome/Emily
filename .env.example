EMILY_LLM_API_KEY=your-api-key-here
EMILY_LLM_BASE_URL=https://api.deepseek.com
EMILY_LLM_MODEL=deepseek-chat
EMILY_API_TOKEN=<生成一个强随机 token，用于 API 鉴权>

# 数据库
EMILY_DATABASE_URL=postgresql://emily:PASSWORD@emily-postgres:5432/emily

# RAG 知识库（可选）
EMILY_KB_ENABLED=false
EMILY_MAXKB_URL=http://maxkb:8080
EMILY_MAXKB_ADMIN_PASSWORD=
EMILY_MAXKB_KNOWLEDGE_ID=

# 存储与配置路径
EMILY_STORAGE_ROOT=/app/attachments
EMILY_HOOK_CONFIG_PATH=/app/config/hook_config.json
EMILY_SOP_REPOSITORY_DIR=/app/sops

# 运行模式（生产环境建议 real）
EMILY_EXECUTOR_MODE=real
EMILY_PLANNER_MODE=real
EMILY_AUTH_MODE=real
EMILY_RISK_MODE=real

# 邮箱（可选）
EMILY_EMAIL_IDKEY=
EMILY_EMAIL_PASSWORD=

# Ops Scheduler（可选）
EMILY_OPS_ENABLED=true
# EMILY_OPS_MAILBOX_ENABLED=true
# EMILY_OPS_MAIL_IMAP_HOST=imap.qq.com
# EMILY_OPS_MAIL_IMAP_PORT=993
# EMILY_OPS_MAIL_USERNAME=ops@company.com
# EMILY_OPS_MAIL_PASSWORD=your-password
# EMILY_OPS_MAIL_SENDER_WHITELIST=admin@company.com
EMILY_OPS_STARTUP_REPORT_ENABLED=true
