from dataclasses import dataclass, field
@dataclass
class RouteResult:
    intent: str
    project_id: str | None = None
    project_name: str | None = None
    confidence: float = 0.0
    data: dict = field(default_factory=dict)
@dataclass
class HandlerResult:
    success: bool
    object_type: str | None = None
    object_id: str | None = None
