                "node_id": node_id,
                "success": True,
                "phase": "discard_node",
                "message": f"[DRY-RUN] 将废弃节点 {node_id}",
                "dry_run": True,
            })
            continue
        cmd = DiscardNodeCommand(
            node_id=node_id,
            operator_id=operator_id,
        )
