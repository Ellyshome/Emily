<mxfile host="CanvasApp" version="1.0" type="device">
  <diagram id="Engineering_Org_AI_Intersection" name="研究脉络交叉空白定位图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="700" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 左椭圆：工程 AI 方向 -->
        <mxCell id="ellipse_A" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="420" height="360" as="geometry" />
        </mxCell>

        <!-- 右椭圆：组织 AI 方向 -->
        <mxCell id="ellipse_B" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;strokeWidth=2;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="420" height="360" as="geometry" />
        </mxCell>

        <!-- 左椭圆标题 -->
        <mxCell id="label_A_title" value="工程 AI 方向" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="180" y="120" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- 左椭圆内容 -->
        <mxCell id="label_A_body" value="具体业务任务&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;规范问答 · 设计辅助&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;风险分析 · 文档处理&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="160" y="200" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- 右椭圆标题 -->
        <mxCell id="label_B_title" value="组织 AI 方向" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- 右椭圆内容 -->
        <mxCell id="label_B_body" value="组织协同能力&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;组织学习 · 人机协作&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;知识管理 · 经验沉淀&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- 交叉区域：团队级 AI 智能体（本文定位） -->
        <mxCell id="intersection" value="★ 交叉空白&lt;br&gt;&lt;b&gt;团队级 AI 智能体&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;（本文定位）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#92400e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- 下方说明文字 -->
        <mxCell id="note_A" value="工程 AI 侧重：具体业务任务的自动化与智能化" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#64748b;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="460" width="300" height="30" as="geometry" />
