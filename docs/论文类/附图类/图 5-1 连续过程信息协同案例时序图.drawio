<mxfile host="CanvasApp" version="1.0" type="device">
  <diagram id="Continuous_Case_Swimlane" name="连续过程信息协同案例泳道图">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ 泳道背景（底层） ============ -->
        <mxCell id="bg_pm" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;strokeWidth=1;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1440" height="110" as="geometry" />
