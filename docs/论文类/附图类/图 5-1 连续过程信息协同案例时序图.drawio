        <!-- ============ 数据底座汇聚（淡灰虚线） ============ -->
        <mxCell id="base_E1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#cbd5e1;strokeWidth=1;dashed=1;" edge="1" parent="1" source="E1" target="lane_base">
