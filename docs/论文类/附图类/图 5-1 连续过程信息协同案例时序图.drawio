        </mxCell>
        <mxCell id="lane_en" value="&lt;b&gt;工程负责人&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;李景利&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;verticalAlign=middle;align=center;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="360" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lane_dir" value="&lt;b&gt;项目总监&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;王建国（未参与）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;verticalAlign=middle;align=center;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="140" height="110" as="geometry" />
