        <mxCell id="lane_base" value="&lt;b&gt;Emily 系统&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;项目数据底座&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;verticalAlign=middle;align=center;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="140" height="90" as="geometry" />
