        <mxCell id="E3" value="&lt;b&gt;事件 E3&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#cbd5e1&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;铺装样品重新送样&lt;br&gt;quality_issue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="373" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="E4" value="&lt;b&gt;事件 E4&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#cbd5e1&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;样板区铺装定样&lt;br&gt;decision · 闭环&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="113" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="Q" value="&lt;b&gt;回溯查询&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#bbf7d0&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;铺装问题后来怎么处理的？&lt;br&gt;（未参与人提问）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="503" width="210" height="84" as="geometry" />
