        <!-- ============ 事件节点（落入对应角色泳道） ============ -->
        <mxCell id="E1" value="&lt;b&gt;事件 E1&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#cbd5e1&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;铺装颜色与效果图差异大&lt;br&gt;quality_issue · 锚点&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
