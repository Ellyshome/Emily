        <mxCell id="rel_E4E1" value="显式关联 E1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=1.5;dashed=1;fontColor=#d97706;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E4" target="E1">
