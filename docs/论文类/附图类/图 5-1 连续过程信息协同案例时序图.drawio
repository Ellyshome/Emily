          <mxGeometry x="20" y="640" width="1440" height="90" as="geometry" />
        </mxCell>

        <!-- ============ 泳道标题方块 ============ -->
        <mxCell id="lane_pm" value="&lt;b&gt;项目经理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;张正宏&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12;verticalAlign=middle;align=center;strokeWidth=1.5;" vertex="1" parent="1">
