<view class="lf-page">
  <view wx:if="{{loading}}" class="lf-center">
    <text class="lf-empty-title">加载中…</text>
  </view>

  <view wx:elif="{{files.length === 0}}" class="lf-center">
    <image class="lf-empty-ic" src="/assets/icons/file.png" mode="aspectFit" />
    <text class="lf-empty-title">暂无本地文件</text>
    <text class="lf-empty-desc">Emily 接收或生成的文件会保存在小程序本地，之后可在这里选择并发送</text>
  </view>

  <scroll-view wx:else class="lf-scroll" scroll-y>
    <view class="lf-list">
      <view
        wx:for="{{files}}"
        wx:key="path"
        class="lf-row"
        hover-class="lf-row-hover"
        hover-stay-time="80"
        data-path="{{item.path}}"
        bindtap="onPick"
      >
        <image wx:if="{{item.isImage}}" class="lf-thumb" src="{{item.path}}" mode="aspectFill" />
        <view wx:else class="lf-ic-wrap">
          <image class="lf-ic" src="/assets/icons/file.png" mode="aspectFit" />
        </view>
        <view class="lf-info">
          <text class="lf-name">{{item.name}}</text>
          <text class="lf-meta">{{item.sizeText}} · {{item.timeText}}<text wx:if="{{item.dir}}"> · {{item.dir}}</text></text>
        </view>
        <text class="lf-send">发送</text>
      </view>
    </view>
    <view class="lf-footer">点击文件即可发送给 Emily</view>
  </scroll-view>
</view>
