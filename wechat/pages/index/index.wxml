<view class="page-shell">
  <!-- 上框：可横向切换的多屏 -->
  <view class="upper" style="{{upperStyle}}">
    <swiper class="screen-swiper" indicator-dots indicator-color="rgba(0,0,0,0.15)" indicator-active-color="#07c160">
      <!-- 屏 1：图片展示 -->
      <swiper-item>
        <view class="screen screen-image">
          <image class="screen-img" src="/assets/demo.png" mode="aspectFill" />
          <text class="screen-tip">示例图 · 替换 assets/demo.png</text>
        </view>
      </swiper-item>
      <!-- 屏 2：图标按钮 -->
      <swiper-item>
        <view class="screen screen-tools">
          <view class="screen-tools-title">快捷功能</view>
          <view class="tools-grid">
            <view
              wx:for="{{tools}}"
              wx:key="key"
              class="tool-item"
              data-name="{{item.name}}"
              bindtap="onToolTap"
            >
              <view class="tool-icon">{{item.icon}}</view>
              <text class="tool-name">{{item.name}}</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 分隔条：上下拖拽调整上框占比 -->
  <view
    class="divider {{dividerActive ? 'divider-active' : ''}}"
    bindtouchstart="onDividerStart"
    bindtouchmove="onDividerMove"
    bindtouchend="onDividerEnd"
    bindtouchcancel="onDividerCancel"
  >
    <view class="divider-grip"></view>
  </view>

  <!-- 下框：对话区 -->
  <view class="lower">
    <scroll-view class="msg-scroll" scroll-y scroll-with-animation scroll-into-view="{{scrollAnchorId}}">
      <view class="msg-list">
        <view wx:for="{{messages}}" wx:key="id" class="msg-row msg-row-{{item.role}}">
          <view wx:if="{{item.role === 'ai'}}" class="msg-avatar">E</view>
          <block wx:if="{{item.type === 'image'}}">
            <view class="msg-media">
              <image class="msg-image" src="{{item.src}}" mode="widthFix" />
            </view>
          </block>
          <block wx:elif="{{item.type === 'file'}}">
            <view class="bubble msg-file">
              <image class="file-ic" src="/assets/icons/file.png" mode="aspectFit" />
              <text class="file-name">{{item.name}}</text>
            </view>
          </block>
          <block wx:else>
            <view class="bubble">{{item.text}}</view>
          </block>
        </view>
        <view id="{{scrollAnchorId}}" class="msg-tail"></view>
      </view>
    </scroll-view>

    <!-- “+”扩展面板 -->
    <view wx:if="{{morePanel}}" class="more-mask" catchtap="closeMorePanel" catchtouchmove="noop"></view>
    <view wx:if="{{morePanel}}" class="more-panel">
      <view class="more-item" data-type="album" bindtap="onMoreTap">
        <view class="more-icon">
          <image class="more-icon-img" src="/assets/icons/photo.png" mode="aspectFit" />
        </view>
        <text class="more-label">相册</text>
      </view>
      <view class="more-item" data-type="camera" bindtap="onMoreTap">
        <view class="more-icon">
          <image class="more-icon-img" src="/assets/icons/camera.png" mode="aspectFit" />
        </view>
        <text class="more-label">拍摄</text>
      </view>
      <view class="more-item" data-type="file-local" bindtap="onMoreTap">
        <view class="more-icon">
          <image class="more-icon-img" src="/assets/icons/file-local.png" mode="aspectFit" />
        </view>
        <text class="more-label">本地文件</text>
      </view>
      <view class="more-item" data-type="file-wechat" bindtap="onMoreTap">
        <view class="more-icon">
          <image class="more-icon-img" src="/assets/icons/file-wechat.png" mode="aspectFit" />
        </view>
        <text class="more-label">微信文件</text>
      </view>
    </view>

    <!-- 输入条 -->
    <view class="input-bar">
      <view class="func-btn" bindtap="toggleVoice">
        <image
          wx:if="{{!voiceMode}}"
          class="func-icon"
          src="/assets/icons/voice.png"
          mode="aspectFit"
        />
        <image wx:else class="func-icon" src="/assets/icons/keyboard.png" mode="aspectFit" />
      </view>
      <view wx:if="{{!voiceMode}}" class="input-wrap">
        <input
          class="input"
          value="{{inputValue}}"
          placeholder="输入消息…"
          confirm-type="send"
          bindinput="onInput"
          bindconfirm="sendMessage"
        />
      </view>
      <view wx:else class="hold-talk" bindtouchstart="onHoldTalk">按住 说话</view>
      <view class="func-btn" bindtap="toggleMorePanel">
        <image class="func-icon" src="/assets/icons/plus.png" mode="aspectFit" />
      </view>
      <view
        wx:if="{{!voiceMode && inputValue}}"
        class="send-btn"
        hover-class="send-btn-hover"
        hover-stay-time="80"
        bindtap="sendMessage"
      >发送</view>
    </view>
  </view>
</view>
